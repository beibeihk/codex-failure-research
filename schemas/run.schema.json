{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Versioned reliability run",
  "type": "object",
  "required": ["run_id","scenario","condition","repetition","codex_version","platform","harness_version","fixture_version","scenario_version","model","duration_seconds","exit_code","model_requests","tool_outputs","mcp_items","tool_available","tool_calls","server_traces","execution_valid","success","failure_types","attribution","fixture_sha256","scenario_sha256","binary_sha256","order_seed"],
  "properties": {
    "run_id":{"type":"string","minLength":1},
    "scenario":{"const":"mcp-inventory-error-visibility"},
    "condition":{"enum":["healthy_aggregate","empty_aggregate","error_aggregate","error_named","mixed_aggregate","template_error_aggregate","template_error_named","invalid_aggregate"]},
    "repetition":{"type":"integer","minimum":1},
    "codex_version":{"type":"string"},
    "platform":{"type":"string"},
    "harness_version":{"type":"string"},
    "fixture_version":{"type":"string"},
    "scenario_version":{"type":"string"},
    "model":{"type":"string"},
    "duration_seconds":{"type":"number","minimum":0},
    "exit_code":{"type":"integer"},
    "model_requests":{"type":"integer","minimum":0},
    "tool_outputs":{"type":"array"},
    "mcp_items":{"type":"array"},
    "tool_available":{"type":"boolean"},
    "tool_calls":{"type":"integer","minimum":0},
    "server_traces":{"type":"object"},
    "execution_valid":{"type":"boolean"},
    "success":{"type":["boolean","null"]},
    "failure_types":{"type":"array","items":{"enum":["F07","F08"]}},
    "attribution":{"enum":["model","harness","environment","evaluation","ambiguous"]},
    "fixture_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "scenario_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "binary_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "order_seed":{"type":"integer"}
  },
  "additionalProperties": true
}
